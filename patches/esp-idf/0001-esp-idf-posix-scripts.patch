From: otaxhu <oscarperniamoreno@gmail.com>
Date: Sun, 21 Jun 2026 22:20:10 -0400
Subject: [PATCH] Added POSIX support for ESP-IDF shell scripts

diff --git a/export.sh b/export.sh
--- a/export.sh
+++ b/export.sh
@@ -1,3 +1,4 @@
+# shellcheck shell=sh
 # This script should be sourced, not executed.
 
 # shellcheck disable=SC2128,SC2169,SC2039,SC3054 # ignore array expansion warning
@@ -53,6 +54,7 @@ then
     return 1
 fi
 
+# shellcheck source=/dev/null
 . "${idf_path}/tools/detect_python.sh"
 
 # Evaluate the ESP-IDF environment set up by the activate.py script.
diff --git a/install.sh b/install.sh
--- a/install.sh
+++ b/install.sh
@@ -1,4 +1,4 @@
-#!/usr/bin/env bash
+#!/bin/sh
 
 set -e
 set -u
@@ -10,6 +10,7 @@ export IDF_PATH
 echo "INFO: Using IDF_PATH '${IDF_PATH}' for installation."
 
 echo "Detecting the Python interpreter"
+# shellcheck source=/dev/null
 . "${IDF_PATH}/tools/detect_python.sh"
 
 echo "Checking Python compatibility"

# Rendering help message logic. {{{
# Simple manpage-like help message.

_vidf_help_render()
{
  local line
  while IFS="" read -r line
  do
    case "$line" in
      USAGE|COMMANDS|"GLOBAL OPTIONS")
        # Title sections styles
        printf "%s%s" "$(_vidf_style_bold)" "$line"
        ;;
      "$(printf "%*s" 4 "")"[a-zA-Z0-9]*)
        # Commands styles
        printf "%s%s" "$(_vidf_style_bold)" "$line"
        ;;
      "$(printf "%*s" 12 "")"-*)
        # Command option styles
        printf "%s%s" "$(_vidf_style_bold)" "$line"
        ;;
      *)
        # Bypass styles
        printf "%s" "$line"
        ;;
    esac
    printf "%s\n" "$(_vidf_style_reset)"

  done << EOF # You can add more styles to the here-doc below if the above ones doesn't fully style it.

vidf - Version Manager for ESP-IDF ($(vidf --version))

USAGE
    vidf <command> [options ...] [--] [arguments ...]

COMMANDS
    install [$(_vidf_style_underline)version$(_vidf_style_ununderline)]
        Installs $(_vidf_style_bold)ESP-IDF$(_vidf_style_unbold) latest release. If a specific $(:
        )$(_vidf_style_underline)version$(_vidf_style_ununderline) is provided, that version will $(:
        )be installed instead.

        Options:
            -y
                Automatic yes to all prompts.

            --repair
                Repairs the $(_vidf_style_bold)ESP-IDF$(_vidf_style_unbold) installation if $(:
                )it's $(_vidf_style_bold)dirty$(_vidf_style_unbold) (git detected modifications) $(:
                )or $(_vidf_style_bold)corrupted$(_vidf_style_unbold).

            -t, --targets <$(_vidf_style_underline)TARGETS$(_vidf_style_ununderline)>
                Specify which $(_vidf_style_underline)target boards$(_vidf_style_ununderline) to $(:
                )install for this $(_vidf_style_bold)ESP-IDF$(_vidf_style_unbold) installation.
                If not specified, user will be prompted with an interactive menu.

    self-update [$(_vidf_style_underline)version$(_vidf_style_ununderline)]
        Updates $(_vidf_style_bold)vidf$(_vidf_style_unbold) to the latest release. $(:
        )If a specific $(_vidf_style_underline)version$(_vidf_style_ununderline) $(:
        )is provided, that version will be installed instead.

        Options:
            -y
                Automatic yes to all prompts.

GLOBAL OPTIONS
    -h, --help
        Shows this message.

    --color <$(_vidf_style_underline)WHEN$(_vidf_style_ununderline)>
        Controls color output. Can be 'always', 'never', or 'auto' (default).

    -v, --version
        Prints currently installed vidf version and exits.

    --
        Delimits end of option processing. Any subsequent arguments
        are treated strictly as positional arguments.
EOF
}

# }}}

vidf()
{
  # Handle shell flags first, this is in order to avoid any unexpected
  # behaviours before executing any important commands that modifies the system.

  local default_ifs
  default_ifs=" $(_vidf_echo t | command tr t \\t)
"
  case "$-" in
    *e*)
      set +e
      local exit_code
      IFS="$default_ifs" vidf "$@"
      exit_code="$?"
      set -e
      return "$exit_code"
      ;;
    *a*)
      set +a
      local exit_code
      IFS="$default_ifs" vidf "$@"
      exit_code="$?"
      set -a
      return "$exit_code"
      ;;
    *E*)
      # Only if running on Bash
      if [ -n "${BASH-}" ]
      then
        # shellcheck disable=SC3041
        set +E
        local exit_code
        IFS="$default_ifs" vidf "$@"
        exit_code="$?"
        # shellcheck disable=SC3041
        set -E
        return "$exit_code"
      fi
      ;;
    *)
      if [ "$IFS" != "$default_ifs" ]
      then
        IFS="$default_ifs" vidf "$@"
        return "$?"
      fi
      ;;
  esac

  # First setup based on tty detection.
  _vidf_style_setup

  # {{{
  # Extract and filter out subcommand, canonize user's arguments, filter and
  # handle all global options from the canonized arguments.

  # Find subcommand
  local subcommand
  subcommand="$(_vidf_find_subcommand "$@")"

  # Filter out subcommand
  eval "$(_vidf_filter_subcommand_eval "$@")"

  local global_format
  global_format="--help,-h,--version,-v,--color:"

  # Add here additional options for each subcommand, they must not conflict
  # with the global options names.
  case "$subcommand" in
    self-update)
      global_format="$global_format,-y"
      ;;
    install)
      global_format="$global_format,-y,--repair,-t/--targets:"
      ;;
  esac

  # Canonize the arguments.
  if ! eval "$(_vidf_canonize_args_eval "$global_format" "$@")"
  then
    return 1
  fi

  local i
  local eoo # End Of Options, is -- present?
  eoo=0
  local flag_action

  local invalid_value
  invalid_value=0

  local skip_arg
  skip_arg=0

  local err_msg

  # Handle global options
  for i in "$@"
  do
    # Circular shift filter, in order to remove global options.
    shift

    if [ "$skip_arg" = 1 ]
    then
      skip_arg=0
      continue
    fi

    if [ "$eoo" = 1 ]
    then
      set -- "$@" "$i"
      continue
    fi

    case "$i" in
      --)
        eoo=1
        set -- "$@" "$i"
        ;;
      -h|--help)
        flag_action=help
        ;;
      --color)
        case "$1" in
          always)
            _vidf_style_setup 1
            ;;
          never)
            _vidf_style_setup 0
            ;;
          auto)
            _vidf_style_setup
            ;;
          *)
            err_msg="$(printf "%s${err_msg:+"\n"}Invalid value for --color: '%s'" "$err_msg" "$1")"
            invalid_value=1
            ;;
        esac

        skip_arg=1
        ;;
      -v|--version)
        # Add here the flag actions that may have higher priority
        case "$flag_action" in
          help)
            :
            ;;
          *)
            flag_action=version
            ;;
        esac
        ;;
      *)
        set -- "$@" "$i"
        ;;
    esac
  done

  # }}}
  # End of canonization, at this point the we've handled global options.

  if [ "$invalid_value" = 1 ]
  then
    _vidf_error "$err_msg"
    _vidf_help_render >&2
    return 1
  fi

  # Early return, before handling flag actions
  if [ "$_VIDF_STYLE_SETUP" = 1 ]
  then
    return 0
  fi

  case "$flag_action" in
    help)
      _vidf_help_render
      return 0
      ;;
    version)
      _vidf_echo "$_VIDF_VERSION"
      return 0
      ;;
  esac

  if [ -z "$subcommand" ]
  then
    _vidf_error "You must specify a subcommand."
    _vidf_help_render >&2
    return 1
  fi

  # Guard-clause for subcommands that require the app dir to be present.
  case "$subcommand" in
    self-update)
      # self-update doesn't require app dir to be present, since it creates it.
      ;;
    install)
      # Add to pattern above subcommands that require the app dir to be present
      if ! [ -d "$(_vidf_app_dir)" ]
      then
        _vidf_error "$(_vidf_style_bold)vidf$(_vidf_style_unbold) installation not found."
        _vidf_info "To install it, run: $(_vidf_style_bold)vidf self-update$(_vidf_style_unbold)"
        _vidf_info "Or execute the installer directly: $(_vidf_style_bold)./vidf$(_vidf_style_unbold)"
        return 1
      fi
      ;;
  esac

  case "$subcommand" in
    self-update)
      if ! _vidf_has git
      then
        _vidf_error "$(_vidf_style_bold)git$(_vidf_style_unbold) not found on" \
          "$(_vidf_style_underline)PATH$(_vidf_style_ununderline)," \
          "this is a required dependency for the" \
          "$(_vidf_style_bold)self-update$(_vidf_style_unbold) subcommand."
        return 1
      fi

      local yes_flag
      if ! eval "$(_vidf_parse_args_eval 0-1,-y yes_flag "$@")"
      then
        return 1
      fi

      local root_dir
      if ! root_dir="$(_vidf_app_dir)"
      then
        return 1
      fi

      # Where vidf is going to be cloned into.
      local install_dir
      install_dir="$root_dir/vidf"

      # Decentralizing and supporting forks, while I solve the problem
      # of distributing the tool through more secure package managers.
      local repo_url
      repo_url="${VIDF_SELF_UPDATE_GIT_URL:-"https://github.com/otaxhu/vidf"}"

      local version_tag
      version_tag="${1:-}"
      if [ -z "$version_tag" ]
      then
        _vidf_info "Checking for the latest remote version..."
        version_tag="$(
          git ls-remote --tags --refs "$repo_url" | \
          awk -F/ '{print $3}' | \
          grep -Ex 'v[0-9]+\.[0-9]+\.[0-9]+' | \
          sort -t . -k 1,1 -k 2,2 -k 3,3 -r | head -n1
        )"
        if [ -z "$version_tag" ]
        then
          _vidf_error "Couldn't determine the latest remote version. Try again."
          return 1
        fi
        _vidf_info "Found latest version" \
          "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold)"
      else
        if ! _vidf_git_remote_tag_exists "$repo_url" "$version_tag"
        then
          _vidf_error "Version $(_vidf_style_bold)$version_tag$(_vidf_style_unbold) not found on remote"
          return 1
        fi
      fi

      local is_installing

      if ! [ -d "$install_dir/.git" ]
      then
        is_installing=1

        # Offer vidf installation to the user.

        # Print short GPL notice
        _vidf_err "Welcome to vidf (Version Manager for ESP-IDF)"
        _vidf_err "Copyright (C) 2026 Oscar Pernia"
        _vidf_err "This program comes with ABSOLUTELY NO WARRANTY."
        _vidf_err "This is free software, and you are welcome to redistribute it"
        _vidf_err "under certain conditions."
        _vidf_err ""

        if [ "$yes_flag" != 1 ]
        then
          _vidf_info "$(_vidf_style_bold)vidf ($version_tag)$(_vidf_style_unbold) is going to be installed on" \
            "$(_vidf_style_bold)$root_dir$(_vidf_style_unbold)"
          _vidf_info "If you wish to choose another directory for the installation, please cancel, set" \
            "$(_vidf_style_underline)VIDF_DIR$(_vidf_style_ununderline)" \
            "variable and try again."
          _vidf_user_confirms || return 1
        fi

        _vidf_info "Installing $(_vidf_style_bold)vidf ($version_tag)$(_vidf_style_unbold)" \
          "on $(_vidf_style_bold)$root_dir$(_vidf_style_unbold)..."
      else
        is_installing=0

        local cur_version
        # Don't use `vidf --version`, since the format for git tags is different.z
        if cur_version="$(_vidf_git_describe_dirty "$install_dir")"
        then
          if [ "$cur_version" != "${cur_version%"-dirty"}" ]
          then
            _vidf_warn "Detected modifications to vidf installation! If you continue you will lose those changes."
          elif [ "$cur_version" = "$version_tag" ]
          then
            _vidf_success "$(_vidf_style_bold)vidf$(_vidf_style_unbold) is already updated to version" \
              "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold). Nothing to do!"
            return 0
          fi
        else
          cur_version="unknown"
          _vidf_warn "Couldn't determine the current vidf version using git. Attempting to update anyways"
        fi

        if [ "$yes_flag" != 1 ]
        then
          _vidf_info "$(_vidf_style_bold)vidf$(_vidf_style_unbold) is going to be updated to the following version:"
          _vidf_info "$(_vidf_style_bold)$cur_version$(_vidf_style_unbold) (currently installed) ->" \
            "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold) (new)"

          _vidf_user_confirms || return 1
        fi

        _vidf_info "Updating $(_vidf_style_bold)vidf$(_vidf_style_unbold) to version" \
          "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold)..."
      fi

      _vidf_git_ensure_switch "$install_dir" "$repo_url" "$version_tag" || return

      if [ "$is_installing" = 1 ]
      then
        _vidf_success "$(_vidf_style_bold)vidf$(_vidf_style_unbold) version" \
          "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold) installed successfully"

        _vidf_err ""
        _vidf_err "$(_vidf_style_bold)Next steps to complete the installation:$(_vidf_style_unbold)"
        _vidf_err "Add the $(_vidf_style_underline)VIDF_DIR$(_vidf_style_ununderline)" \
          "directory and source the script by appending the following lines"
        _vidf_err "to your shell profile script (e.g., ~/.bashrc, ~/.zshrc, or ~/.profile):"
        _vidf_err "$(_vidf_style_bold)" # Command block start
        if [ "$root_dir" = "$HOME/.vidf" ]
        then
          _vidf_err "  export VIDF_DIR=\"\$HOME/.vidf\""
        else
          _vidf_err "  export VIDF_DIR=$(_vidf_sanitize_arg "$root_dir")"
        fi
        _vidf_err "  . \"\$VIDF_DIR/vidf/vidf\""
        _vidf_err "$(_vidf_style_unbold)" # Command block end
        _vidf_err "After adding it, restart your terminal or run source command"
      else
        _vidf_success "$(_vidf_style_bold)vidf$(_vidf_style_unbold) updated to version" \
          "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold) succesfully"
      fi
      ;;
    install)
      local missing_dep
      missing_dep=0
      if ! _vidf_has git
      then
        missing_dep=1
        _vidf_error "$(_vidf_style_bold)git$(_vidf_style_unbold) not found on" \
          "$(_vidf_style_underline)PATH$(_vidf_style_ununderline)," \
          "this is a required dependency for the" \
          "$(_vidf_style_bold)install$(_vidf_style_unbold) subcommand."
      fi
      if ! _vidf_has python \
        && ! _vidf_has python3
      then
        missing_dep=1
        _vidf_error "$(_vidf_style_bold)python$(_vidf_style_unbold) not found on" \
          "$(_vidf_style_underline)PATH$(_vidf_style_ununderline)," \
          "this is a required dependency for the" \
          "$(_vidf_style_bold)install$(_vidf_style_unbold) subcommand."
      fi
      if ! _vidf_has curl
      then
        missing_dep=1
        _vidf_error "$(_vidf_style_bold)curl$(_vidf_style_unbold) not found on" \
          "$(_vidf_style_underline)PATH$(_vidf_style_ununderline)," \
          "this is a required dependency for the" \
          "$(_vidf_style_bold)install$(_vidf_style_unbold) subcommand."
      fi
      if ! _vidf_has jq
      then
        missing_dep=1
        _vidf_error "$(_vidf_style_bold)jq$(_vidf_style_unbold) not found on" \
          "$(_vidf_style_underline)PATH$(_vidf_style_ununderline)," \
          "this is a required dependency for the" \
          "$(_vidf_style_bold)install$(_vidf_style_unbold) subcommand."
      fi
      [ "$missing_dep" = 1 ] && return 1

      local yes_flag
      local repair_flag
      local targets_flag
      if ! eval "$(_vidf_parse_args_eval 0-1,-y,--repair,-t/--targets: yes_flag,repair_flag,targets_flag "$@")"
      then
        return 1
      fi

      local root_dir
      if ! root_dir="$(_vidf_app_dir)"
      then
        return 1
      fi

      local vidf_install_dir
      vidf_install_dir="$root_dir/vidf"

      local idf_versions_dir
      idf_versions_dir="$root_dir/idf-versions"

      local repo_url
      repo_url="${VIDF_INSTALL_IDF_GIT_URL:-"https://github.com/espressif/esp-idf"}"

      local idf_version_tag
      idf_version_tag="$1"
      if [ -z "$idf_version_tag" ]
      then
        _vidf_info "Checking for the latest" \
          "$(_vidf_style_bold)ESP-IDF$(_vidf_style_unbold)" \
          "remote version..."
        idf_version_tag="$(
          git ls-remote --tags --refs "$repo_url" |
          awk -F/ '{print $3}' |
          # Weird version naming convention from ESP-IDF, they aren't following semver
          grep -Ex 'v[0-9]+\.[0-9]+(\.[0-9]+)?' |
          sort -t . -k 1,1 -k 2,2 -k 3,3 -r | head -n1
        )"
        if [ -z "$idf_version_tag" ]
        then
          _vidf_error "Couldn't determine the latest" \
            "$(_vidf_style_bold)ESP-IDF$(_vidf_style_unbold)" \
            "remote version. Try again."
          return 1
        fi
        _vidf_info "Found latest remote version" \
          "$(_vidf_style_bold)$idf_version_tag$(_vidf_style_unbold)"
      else
        if ! _vidf_git_remote_tag_exists "$repo_url" "$idf_version_tag"
        then
          _vidf_error "Version $(_vidf_style_bold)$idf_version_tag$(_vidf_style_unbold) not found on remote"
          return 1
        fi
      fi

      _vidf_info "Checking target board compatibility for" \
        "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)..."

      local idf_versions_json
      if ! idf_versions_json="$(_vidf_download_file "https://dl.espressif.com/dl/esp-idf/idf_versions.json")"
      then
        _vidf_error "Couldn't determine available target boards"
        return 2
      fi

      local is_original_json
      ! jq -e 'type == "object"' "$idf_versions_json" >/dev/null
      is_original_json="$?"

      # Compact JSON and move results to cache dir, only if it's original JSON
      #
      # Findings:
      #
      # There is an issue with the original JSON file, there is duplicated "name"
      # keys in "VERSIONS" array, as well as duplicated values in
      # "supported_targets" array, we de-duplicate them.
      #
      # We don't support "pre_release"s and "latest" versions, since those doesn't
      # exists as git tags in the git repository, filter them out as well.
      if [ "$is_original_json" = 1 ]
      then
        local temp_json
        temp_json="$(mktemp)"

        local jq_exit_code
        jq_exit_code=0

        if ! jq -c '
          .VERSIONS | unique_by(.name) |
          map(
            # Discards pre_releases, latest versions and objects with empty supported_targets
            select(.pre_release or .name == "latest" or (.supported_targets // [] | length == 0) | not) |
            {
              name: .name,
              supported_targets: .supported_targets | unique
            }
          )
        ' "$idf_versions_json" > "$temp_json"
        then
          jq_exit_code=1
          _vidf_error "Couldn't compact $(_vidf_style_bold)idf_versions.json$(_vidf_style_unbold)." \
            "Please file an issue!"
        elif ! mv -f "$temp_json" "$idf_versions_json"
        then
          jq_exit_code=1
          _vidf_error "Couldn't move compacted $(_vidf_style_bold)idf_versions.json$(_vidf_style_unbold)" \
            "into cache directory"
        fi

        if [ "$jq_exit_code" != 0 ]
        then
          rm -f "$temp_json"
          return 2
        fi
      fi

      # JSON array of strings
      local supported_targets
      if ! supported_targets="$(
        jq -c --arg tag "$idf_version_tag" '
          .[] | select(.name == $tag) | .supported_targets
        ' "$idf_versions_json"
      )"
      then
        _vidf_error "Couldn't parse $(_vidf_style_bold)idf_versions.json$(_vidf_style_unbold)." \
          "Please file an issue!"
        return 2
      fi

      # Directory where ESP-IDF is going to be cloned into.
      local install_dir
      install_dir="$idf_versions_dir/$idf_version_tag"

      if ! [ -d "$install_dir/.git" ]
      then
        # Disable repair_flag in order to show proper success message below.
        repair_flag=0
      else
        local cur_version
        if cur_version="$(_vidf_git_describe_dirty "$install_dir")"
        then
          if [ "$cur_version" != "${cur_version%"-dirty"}" ]
          then
            _vidf_warn "Detected modifications to" \
              "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)" \
              "installation!"
          elif [ "$cur_version" = "$idf_version_tag" ] && [ "$repair_flag" != 1 ]
          then
            _vidf_success "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)" \
              "already installed. Nothing to do!"
            return 0
          fi
        else
          _vidf_warn "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)" \
            "installation corrupted."
        fi
        if [ "$repair_flag" != 1 ]
        then
          _vidf_info "Use $(_vidf_style_bold)--repair$(_vidf_style_unbold)" \
            "in order to repair this version."
          return 0
        fi
      fi

      if [ -n "$targets_flag" ]
      then
        targets_flag="$(
          _vidf_echo "$targets_flag" |
          tr ',' '\n' |
          while IFS="" read -r line
          do
            printf " %s" "$(_vidf_sanitize_arg "$line")"
          done
        )"

        # Check that targets work on selected version tag
        local unsupported_targets
        if ! unsupported_targets="$(
          _vidf_echo "$targets_flag" | xargs \
            jq -rn --argjson supported "$supported_targets" '
              $ARGS.positional[] | select(. as $input | $supported | index($input) | not)
            ' --args --
        )"
        then
          _vidf_error "Couldn't determine incompatible target boards. Please file an issue!"
          return 2
        fi

        if [ -n "$unsupported_targets" ]
        then
          _vidf_error "The following board targets specified in" \
            "$(_vidf_style_bold)--targets$(_vidf_style_unbold) flag are unsupported for" \
            "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold):"
          _vidf_error "$(_vidf_style_bold)$(_vidf_echo "$unsupported_targets" | tr "\n" " ")$(_vidf_style_unbold)"
          _vidf_info "Valid values are:"
          _vidf_info "$(_vidf_style_bold)$(_vidf_echo "$supported_targets" | jq -r '.[]' | tr "\n" " ")$(_vidf_style_unbold)"
          return 1
        fi
      else
        local supported_targets_sh
        supported_targets_sh="$(
          jq -rn --argjson supported "$supported_targets" '
            $supported[]
          ' |
          while IFS="" read -r line
          do
            printf " %s" "$(_vidf_sanitize_arg "$line")"
          done
        )"

        # Ask user for which ESP boards he is targetting
        if ! targets_flag="$(
          eval "_vidf_user_multi_select \"Select ESP-IDF target boards to install\" $supported_targets_sh"
        )"
        then
          return 1
        fi
        if [ -z "$targets_flag" ]
        then
          _vidf_error "You must select at least 1 target board"
          return 1
        fi
      fi

      if [ "$repair_flag" = 1 ]
      then
        _vidf_info "Repairing" \
          "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)..."
      else # Installing
        if [ "$yes_flag" != 1 ]
        then
          _vidf_info "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)" \
            "is going to be installed."
          _vidf_info "With the following target boards:" \
            "$(_vidf_style_bold)$(_vidf_echo "$targets_flag" | xargs)$(_vidf_style_unbold)"
          _vidf_user_confirms || return
        fi
        _vidf_info "Installing $(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)..."
      fi

      # From here downwards is the slow function calls.
      #
      # We've gathered all the information the user needs to give us, now he must wait.

      _vidf_git_ensure_switch "$install_dir" "$repo_url" "$idf_version_tag" || return

      _vidf_info "Applying patches to ESP-IDF..."
      if ! git -c core.fileMode=false \
        apply --no-index --directory="$install_dir" --quiet -R --check --unsafe-paths \
        "$vidf_install_dir"/patches/esp-idf/*.patch \
        && ! git -c core.fileMode=false \
          apply --no-index --directory="$install_dir" --unsafe-paths \
          "$vidf_install_dir"/patches/esp-idf/*.patch
      then
        _vidf_error "Couldn't apply patches to ESP-IDF installation. Please file an issue!"
        return 2
      fi

      _vidf_info "Running $(_vidf_style_bold)install.sh$(_vidf_style_unbold)..."
      if ! _vidf_echo "$targets_flag" | xargs sh -- "$install_dir/install.sh"
      then
        _vidf_error "$(_vidf_style_bold)install.sh$(_vidf_style_unbold) failed to run"
        return 2
      fi

      if [ "$repair_flag" = 1 ]
      then
        _vidf_success "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)" \
          "was succesfully repaired."
      else
        _vidf_success "$(_vidf_style_bold)ESP-IDF ($idf_version_tag)$(_vidf_style_unbold)" \
          "was succesfully installed."
      fi

      _vidf_err ""
      _vidf_err "In order to activate your ESP-IDF environment, run:"
      _vidf_err "$(_vidf_style_bold)" # Command start block
      _vidf_err "  vidf use $(_vidf_sanitize_arg "$idf_version_tag")"
      _vidf_err "$(_vidf_style_unbold)" # Command end block
      ;;
    *)
      _vidf_error "Unknown subcommand: $subcommand"
      _vidf_help_render >&2
      return 1
      ;;
  esac
}

if ! _vidf_is_sourced && [ "$_VIDF_TEST" != 1 ]
then
  # Initial setup for colors
  _VIDF_STYLE_SETUP=1 vidf "$@" || exit "$?"

  if ! [ -e "$(_vidf_app_dir)" ]
  then
    # Assume the user is running the script for the first time and is
    # piping it, most likely from curl.

    # Trigger auto-installation. Bypass flags that may be included such as -y
    _vidf_info "No installation found. Running: $(_vidf_style_bold)vidf self-update $*"

    vidf self-update "$@"
    _EXIT_CODE="$?"
    if [ "$_EXIT_CODE" != 0 ]
    then
      _vidf_error "Cleaning up failed installation..."
      rm -rf "$(_vidf_app_dir)"
    fi

    exit "$_EXIT_CODE"
  fi

  _vidf_error "You must source this script in order to use it."
  exit 1
fi

# @formatter:off
} # Ensures the entire script is downloaded
# @formatter:on

# Implemented as a POSIX-compliant shell function. To initialize the tool,
# this script must be executed directly at least once to trigger the installation.
# Subsequent executions and daily usage require sourcing the script to manage
# ESP-IDF environments correctly.
#
# This tool is inspired by NVM (Node Version Manager) project,
# but for managing ESP-IDF (Espressif IoT Development Framework) installations
# and environments.

{ # Ensures the entire script is downloaded

_vidf_is_sourced ()
{
  if [ -n "$ZSH_VERSION" ]
  then
    case "$ZSH_EVAL_CONTEXT" in
      *:file:*|*:file|file:*|file)
        return 0
        ;;
    esac
  else  # Add additional POSIX-compatible shell names here, if needed.
    case "${0##*/}" in
      dash|-dash|bash|-bash|ksh|-ksh|sh|-sh)
        return 0
        ;;
    esac
  fi
  return 1
}

_vidf_err()
{
  echo "$*" >&2
}

_vidf_has()
{
  type "${1-}" >/dev/null 2>&1
  return "$?"
}

# You must pass to it at least 2 arguments, the predicate and the cancelled message.
# A default value is provided for this two, so you can pass empty strings.
#
# Flags:
#
# -y: Automatically confirms
_vidf_user_confirms()
{
  local predicate
  predicate="${1:-"Is this ok?"} [y/N]: "

  local cancelled
  cancelled="${2:-"Operation cancelled."}"

  shift 2

  local i
  for i in "$@"
  do
    case "$i" in
      --)
        break
        ;;
      -y)
        return 0
        ;;
    esac
  done

  printf "%s" "$predicate" >&2

  while true
  do
    local opt
    read -r opt
    case "$opt" in
      [yY][eE][sS]|[yY])
        return 0
        ;;
      [nN][oO]|[nN]|"")
        _vidf_err "$cancelled"
        return 1
        ;;
      *)
        printf "Please enter (y)es or (n)o: " >&2
        ;;
    esac
  done
}

_vidf_app_dir()
{
  printf "%s" "${VIDF_DIR:-"$HOME/.vidf"}"
}

# NOTE: We don't use getopts because it doesn't accept long options
#
# The $1 format parameter is similar to getopts format, except that
# it starts with the minimum number of required positional arguments,
# followed by a comma-separated list of valid short and long options.
#
# Example format: "2,-y,--prefix:,--version"
_vidf_check_args()
{
  local format
  format="$1"
  shift

  local expected_arg_count
  expected_arg_count="${format%%,*}"

  local flags
  if [ "$format" = "$expected_arg_count" ]
  then
    flags=""
  else
    flags="${format#*,},"
  fi

  local arg_count
  arg_count=0

  while [ "$#" -gt 0 ]
  do
    case "$1" in
      --)
        shift
        arg_count="$((arg_count + $#))"
        break
        ;;
      -*)
        if [ "$flags" != "${flags#*"$1":,*}" ]
        then
          if [ "$#" -lt 2 ]
          then
            _vidf_err "Option \`$1\` requires an argument."
            return 1
          fi

          shift 2
          continue
        fi

        if [ "$flags" != "${flags#*"$1",*}" ]
        then
          shift
          continue
        fi

        _vidf_err "Unexpected option \`$1\`."
        return 1
        ;;
      *)
        arg_count=$((arg_count + 1))
        shift
        ;;
    esac
  done

  if [ "$arg_count" -ne "$expected_arg_count" ]
  then
    _vidf_err "Expected $expected_arg_count positional arguments, but got $arg_count."
    return 1
  fi
}

# ANSI color styles logic. {{{

_VIDF_COLOR=1

_vidf_style_setup()
{
  if [ "$#" -gt 0 ]
  then
    if [ "$1" = 1 ]
    then
      _VIDF_COLOR=1
    else
      _VIDF_COLOR=0
    fi
  elif [ -t 1 ]
  then
    _VIDF_COLOR=1
  else
    _VIDF_COLOR=0
  fi
}

_vidf_style_reset()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[0m"
}

_vidf_style_bold()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1m"
}

_vidf_style_underline()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[4m"
}

_vidf_style_red()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;31m"
}

_vidf_style_green()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;32m"
}

_vidf_style_yellow()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;33m"
}

_vidf_style_cyan()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;36m"
}

# }}}

# Rendering help message logic. {{{
# Simple manpage-like help message.

_vidf_help_render()
{
  local line
  while IFS="" read -r line
  do
    case "$line" in
      # Title sections styles
      USAGE|COMMANDS|OPTIONS)
        printf "%s%s" "$(_vidf_style_bold)" "$line"
        ;;
      # Commands styles
      "$(printf "%*s" 4 "")"[a-zA-Z0-9]*)
        printf "%s%s" "$(_vidf_style_bold)" "$line"
        ;;
      # Command option styles
      "$(printf "%*s" 12 "")"-*)
        printf "%s%s" "$(_vidf_style_bold)" "$line"
        ;;
      # Bypass styles
      *)
        printf "%s" "$line"
        ;;
    esac
    printf "%s\n" "$(_vidf_style_reset)"

  # You can add more styles to the here-doc below if the above ones doesn't fully style it.
  done << EOF

vidf - Version Manager for ESP-IDF

USAGE
    vidf <command> [options] [--] [arguments]

COMMANDS
    self-update
        Upgrades vidf to the latest version.

        Options:
            --version <$(_vidf_style_underline)version$(_vidf_style_reset)>
                Specify a concrete vidf $(_vidf_style_underline)version$(_vidf_style_reset) to update/downgrade to.
            -y
                Automatic yes to all prompts.

    help
        Shows this message.

OPTIONS
    -h, --help
        Shows this message.

    --[no-]color
        Enable or disable ANSI color output explicitly.

    --
        Delimits end of option processing. Any subsequent arguments
        are treated strictly as positional arguments.
EOF
}

# }}}

vidf()
{
  # Handle shell flags first, this is in order to avoid any unexpected
  # behaviours before executing any important commands that modifies the system.

  local default_ifs
  default_ifs=" $(echo t | command tr t \\t)
"
  case "$-" in
    *e*)
      set +e
      local exit_code
      IFS="$default_ifs" vidf "$@"
      exit_code="$?"
      set -e
      return "$exit_code"
      ;;
    *a*)
      set +a
      local exit_code
      IFS="$default_ifs" vidf "$@"
      exit_code="$?"
      set -a
      return "$exit_code"
      ;;
    *E*)
      # Only if running on Bash
      if [ -n "${BASH-}" ]
      then
        # shellcheck disable=SC3041
        set +E
        local exit_code
        IFS="$default_ifs" vidf "$@"
        exit_code="$?"
        # shellcheck disable=SC3041
        set -E
        return "$exit_code"
      fi
      ;;
    *)
      if [ "$IFS" != "$default_ifs" ]
      then
        IFS="$default_ifs" vidf "$@"
        return "$?"
      fi
      ;;
  esac

  # First setup based on tty detection.
  _vidf_style_setup

  if [ "$#" -lt 1 ]
  then
    vidf help >&2
    return 1
  fi

  local subcommand

  # Check all arguments and handle the global options, as well
  # as handling the -- delimiter. We filter and handle all global options
  # from the final arguments, -- is not filtered because subcommands are
  # supposed to handle it.
  local i
  local eoo # End Of Options, is -- present?
  eoo=0
  for i in "$@"
  do
    # Do a circular shift filter, we don't use arrays because they are
    # not available on POSIX shells.
    shift
    if [ "$eoo" = 1 ]
    then
      set -- "$@" "$i"
      continue
    fi
    case "$i" in
      --)
        eoo=1
        set -- "$@" "$i"
        ;;
      -h|--help)
        subcommand=help
        ;;
      --color)
        _vidf_style_setup 1
        ;;
      --no-color)
        _vidf_style_setup 0
        ;;
      *)
        set -- "$@" "$i"
        ;;
    esac
  done

  if [ -z "$subcommand" ]
  then
    if [ -z "${1:-}" ]
    then
      _vidf_err "You must specify a subcommand."

      # We can't do recursive `vidf help` call because then we will lose
      # --[no-]color option.
      _vidf_help_render >&2
      return 1
    fi
    subcommand="$1"
    shift
  fi

  case "$subcommand" in
    help)
      _vidf_help_render
      ;;
    self-update)
      if ! _vidf_check_args 0,-y,--version: "$@"
      then
        return 1
      fi
      if ! [ -e "$VIDF_DIR" ]
      then
        # Offer VIDF installation to the user.

        # Print short GPL notice
        _vidf_err "Welcome to VIDF (Version Manager for ESP-IDF)"
        _vidf_err "Copyright (C) 2026 Oscar Pernia"
        _vidf_err "This program comes with ABSOLUTELY NO WARRANTY."
        _vidf_err "This is free software, and you are welcome to redistribute it"
        _vidf_err "under certain conditions."
        _vidf_err ""

        if ! _vidf_user_confirms "Do you wish to install VIDF on \`$VIDF_DIR\`?" \
                                 "Operation cancelled. If you wish to choose another directory for the installation, please set \`VIDF_DIR\` variable." \
                                 "$@"
        then
          return 1
        fi

        # TODO: All of the VIDF repository cloning logic
        if _vidf_has git
        then
          :
        elif _vidf_has curl
        then
          :
        elif _vidf_has wget
        then
          :
        else
          _vidf_err "Needs one of \`git\`, \`curl\` or \`wget\` in order to install VIDF."
          return 1
        fi

        return 0
      fi

      # TODO: The rest of the logic for `self-update`-ing
      ;;
    *)
      _vidf_err "Unknown subcommand: $subcommand"
      _vidf_help_render >&2
      return 1
      ;;
  esac
}

if ! _vidf_is_sourced
then
  if ! [ -e "$(_vidf_app_dir)" ]
  then
    # Assume the user is running the script for the first time and is
    # piping it, most likely from curl.

    # Trigger auto-installation. Bypass flags that may be included such as -y
    vidf self-update "$@"
    exit "$?"
  fi

  _vidf_err "You must source this script in order to use it."
  exit 1
fi

} # Ensures the entire script is downloaded

# Implemented as a POSIX-compliant shell function. To initialize the tool,
# this script must be executed directly at least once to trigger the installation.
# Subsequent executions and daily usage require sourcing the script to manage
# ESP-IDF environments correctly.
#
# This tool is inspired by NVM (Node Version Manager) project,
# but for managing ESP-IDF (Espressif IoT Development Framework) installations
# and environments.

{ # Ensures the entire script is downloaded

_vidf_is_sourced ()
{
  if [ -n "$ZSH_VERSION" ]
  then
    case "$ZSH_EVAL_CONTEXT" in
      *:file:*|*:file|file:*|file)
        return 0
        ;;
    esac
  else  # Add additional POSIX-compatible shell names here, if needed.
    case "${0##*/}" in
      dash|-dash|bash|-bash|ksh|-ksh|sh|-sh)
        return 0
        ;;
    esac
  fi
  return 1
}

_vidf_err()
{
  echo "$*" >&2
}

_vidf_has()
{
  type "${1-}" >/dev/null 2>&1
  return "$?"
}

_vidf_user_confirms()
{
  local PREDICATE
  PREDICATE="${1-"Is this ok?"}"
  PREDICATE="$PREDICATE [y/N]: "

  local CANCELLED
  CANCELLED="${2-"Operation cancelled."}"

  printf "$PREDICATE" >&2

  while true
  do
    read -r opt
    case "$opt" in
      [yY][eE][sS]|[yY])
        return 0
        ;;
      [nN][oO]|[nN]|"")
        _vidf_err "$CANCELLED"
        return 1
        ;;
      *)
        printf "Please enter (y)es or (n)o: " >&2
        ;;
    esac
  done
}

# ANSI color styles logic. {{{

_VIDF_COLOR=1

_vidf_style_setup()
{
  if [ "$#" -gt 0 ]
  then
    if [ "$1" = 1 ]
    then
      _VIDF_COLOR=1
    else
      _VIDF_COLOR=0
    fi
  elif [ -t 1 ]
  then
    _VIDF_COLOR=1
  else
    _VIDF_COLOR=0
  fi
}

_vidf_style_reset()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[0m"
}

_vidf_style_bold()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1m"
}

_vidf_style_underline()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[4m"
}

_vidf_style_red()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;31m"
}

_vidf_style_green()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;32m"
}

_vidf_style_yellow()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;33m"
}

_vidf_style_cyan()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1;36m"
}

# }}}

# Rendering help message logic. {{{
# Simple manpage-like help message.

_vidf_help_render()
{
  while IFS="" read -r LINE
  do
    case "$LINE" in
      # Title sections styles
      USAGE|COMMANDS|OPTIONS)
        printf "%s%s" "$(_vidf_style_bold)" "$LINE"
        ;;
      # Commands styles
      "$(printf "%*s" 4 "")"[a-zA-Z0-9]*)
        printf "%s%s" "$(_vidf_style_bold)" "$LINE"
        ;;
      # Command option styles
      "$(printf "%*s" 12 "")"--*)
        printf "%s%s" "$(_vidf_style_bold)" "$LINE"
        ;;
      # Bypass styles
      *)
        printf "%s" "$LINE"
        ;;
    esac
    printf "%s\n" "$(_vidf_style_reset)"

  # You can add more styles to the here-doc below if the above ones doesn't fully style it.
  done << EOF

vidf - Version Manager for ESP-IDF

USAGE
    vidf <command> [options] [--] [arguments]

COMMANDS
    self-update
        Upgrades vidf to the latest version.

        Options:
            --version <$(_vidf_style_underline)version$(_vidf_style_reset)>
                Specify a concrete vidf $(_vidf_style_underline)version$(_vidf_style_reset) to update/downgrade to.

    help
        Shows this message.

OPTIONS
    -h, --help
        Shows this message.

    --[no-]color
        Enable or disable ANSI color output explicitly.

    --
        Delimits end of option processing. Any subsequent arguments
        are treated strictly as positional arguments.
EOF
}

# }}}

vidf()
{
  # Handle shell flags first, this is in order to avoid any unexpected
  # behaviours before executing any important commands that modifies the system.

  local DEFAULT_IFS
  DEFAULT_IFS=" $(echo t | command tr t \\t)
"
  case "$-" in
    *e*)
      set +e
      local EXIT_CODE
      IFS="${DEFAULT_IFS}" vidf "$@"
      EXIT_CODE="$?"
      set -e
      return "$EXIT_CODE"
      ;;
    *a*)
      set +a
      local EXIT_CODE
      IFS="${DEFAULT_IFS}" vidf "$@"
      EXIT_CODE="$?"
      set -a
      return "$EXIT_CODE"
      ;;
    *E*)
      # Only if running on Bash
      if [ -n "${BASH-}" ]
      then
        set +E
        local EXIT_CODE
        IFS="${DEFAULT_IFS}" vidf "$@"
        EXIT_CODE="$?"
        set -E
        return "$EXIT_CODE"
      fi
      ;;
    *)
      if [ "${IFS}" != "${DEFAULT_IFS}" ]
      then
        IFS="${DEFAULT_IFS}" vidf "$@"
        return "$?"
      fi
      ;;
  esac

  # First setup based on tty detection.
  _vidf_style_setup

  : "${VIDF_DIR:="$HOME/.vidf"}"

  if [ -e "$VIDF_DIR" ] && ! [ -d "$VIDF_DIR" ]
  then
    _vidf_err "Path specified by VIDF_DIR (\`$VIDF_DIR\`) is not a directory,"
    _vidf_err "try setting \`VIDF_DIR\` to another path,"
    _vidf_err "or delete the previously mentioned path before continuing."
    return 1
  fi

  if [ "$#" -lt 1 ]
  then
    vidf help >&2
    return 1
  fi

  local SUBCOMMAND
  SUBCOMMAND="$1"

  # Check all arguments and handle the global options, as well
  # as handling the -- delimiter
  for i in "$@"
  do
    case "$i" in
      --)
        break
        ;;
      -h|--help)
        SUBCOMMAND=help
        ;;
      --color)
        _vidf_style_setup 1
        ;;
      --no-color)
        _vidf_style_setup 0
        ;;
    esac
  done

  case "$SUBCOMMAND" in
    help)
      _vidf_help_render
      ;;
    self-update)
      if ! [ -e "$VIDF_DIR" ]
      then
        # Offer VIDF installation to the user.

        # Print short GPL notice
        _vidf_err "Welcome to VIDF (Version Manager for ESP-IDF)"
        _vidf_err "Copyright (C) 2026 Oscar Pernia"
        _vidf_err "This program comes with ABSOLUTELY NO WARRANTY."
        _vidf_err "This is free software, and you are welcome to redistribute it"
        _vidf_err "under certain conditions."
        _vidf_err ""

        if ! _vidf_user_confirms "Do you wish to install VIDF on \`$VIDF_DIR\`?"
        then
          return 1
        fi

        # TODO: All of the VIDF repository cloning logic
        if _vidf_has git
        then
          :
        elif _vidf_has curl
        then
          :
        elif _vidf_has wget
        then
          :
        else
          _vidf_err "Needs one of \`git\`, \`curl\` or \`wget\` in order to install VIDF."
          return 1
        fi

        return 0
      fi

      # TODO: The rest of the logic for `self-update`-ing
      ;;
    *)
      _vidf_err "Unknown subcommand: $SUBCOMMAND"
      vidf help >&2
      return 1
      ;;
  esac
}

if ! _vidf_is_sourced
then
  if [ "$#" -ne 0 ]
  then
    _vidf_err "You must source this script in order to use it."
    _vidf_err ""
    _vidf_err "If you wish to install VIDF, run it without any arguments first."
    _vidf_err "Try running \`yes | vidf\` in order to perform a default installation."
    exit 1
  fi

  # Trigger auto-installation.
  vidf self-update
fi

} # Ensures the entire script is downloaded

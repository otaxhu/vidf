_VIDF_COLOR=1

_vidf_style_setup()
{
  if [ "$#" -gt 0 ]
  then
    if [ "$1" = 1 ]
    then
      _VIDF_COLOR=1
    else
      _VIDF_COLOR=0
    fi
  elif [ -t 1 ]
  then
    _VIDF_COLOR=1
  else
    _VIDF_COLOR=0
  fi
}

_vidf_style_reset()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[0m"
}

_vidf_style_bold()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[1m"
}

_vidf_style_underline()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[4m"
}

_vidf_style_red()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[31m"
}

_vidf_style_green()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[32m"
}

_vidf_style_yellow()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[33m"
}

_vidf_style_cyan()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[36m"
}

_vidf_style_unbold()
{
  [ "$_VIDF_COLOR" = "1" ] && printf "\033[22m"
}

_vidf_style_ununderline()
{

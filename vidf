# Git-related functions {{{

# Helper functions:

_vidf_git_base()
{
  local install_dir
  install_dir="$1"
  shift
  git --git-dir="$install_dir/.git" "$@"
}

_vidf_git_wt()
{
  local install_dir
  install_dir="$1"
  shift
  if [ "$1" = "submodule" ]
  then
    # Old bug with git submodule, it dates back to 2018. See:
    #
    # https://stackoverflow.com/questions/48767595/
    #
    # You have to cd into the working directory, since git submodule doesn't
    # respect --work-tree option
    _vidf_git_base "$install_dir" --work-tree="$install_dir" -C "$install_dir" "$@"
  else
    _vidf_git_base "$install_dir" --work-tree="$install_dir" "$@"
  fi
}

# Initializes a git repository.
_vidf_git_init()
{
  local install_dir
  install_dir="$1"

  if ! mkdir -p "$install_dir"
  then
    _vidf_error "Failed to create directory" \
      "$(_vidf_style_bold)$install_dir$(_vidf_style_unbold)"
    return 2
  fi

  if ! _vidf_git_base "$install_dir" init "$install_dir" -q
  then
    _vidf_error "Failed to initialize git repository on" \
      "$(_vidf_style_bold)$install_dir$(_vidf_style_unbold)"
    return 2
  fi

  return 0
}

# Fetches the version tag or branch, switches the repository to use that version,
# And updates any present submodules recursively. Additionally, it prunes the repository,
# which is very useful for long-living installations, such as ESP-IDF.
#
# This works for any repository, not only vidf's, e.g. ESP-IDF's.
_vidf_git_switch()
{
  local install_dir
  install_dir="$1"
  local repo_url
  repo_url="$2"
  local version_tag
  version_tag="$3"

  if ! _vidf_git_base "$install_dir" remote add origin "$repo_url" 2>/dev/null \
    && ! _vidf_git_base "$install_dir" remote set-url origin "$repo_url" 2>/dev/null
  then
    _vidf_error "Failed to add/set git remote origin" \
      "$(_vidf_style_bold)$repo_url$(_vidf_style_bold)"
    return 2
  fi

  # Fetch tag first
  local temp_err
  temp_err="$(mktemp)"

  local git_exit_code
  _vidf_git_wt "$install_dir" fetch origin tag "$version_tag" --depth=1 -j"$(nproc)" 2>"$temp_err"
  git_exit_code="$?"

  # Remove fatal lines from output, in order to not panic the user.
  sed -E '/^fatal:/d' "$temp_err" >&2
  rm -f "$temp_err"

  if [ "$git_exit_code" -ne 0 ] \
    && ! _vidf_git_wt "$install_dir" fetch origin "$version_tag" --depth=1 -j"$(nproc)"
  then
    _vidf_error "Failed to git fetch version" \
      "$(_vidf_style_bold)$version_tag$(_vidf_style_unbold)"
    return 2
  fi

  if ! _vidf_git_wt "$install_dir" switch -qdf FETCH_HEAD
  then
    _vidf_error "Failed to git switch to version" \
      "$(_vidf_style_bold)$version_tag$(_vidf_style_bold)"
    return 2
  fi

  if ! _vidf_git_wt "$install_dir" submodule update --init --recursive --depth=1 -j"$(nproc)"
  then
    _vidf_error "Failed to update the submodules"
    return 2
  fi

  # Don't use `git submodule update --force` above, it's very slow on ESP-IDF project
  # and big repos, use `git submodule foreach` optimization instead.
  if ! _vidf_git_wt "$install_dir" submodule foreach --recursive -q '
    desc="$(git describe --tags --dirty --always)" || exit 1
    if ! printf "%s" "$desc" | grep -qE -- "-dirty$"
    then
      # Continue foreach
      exit 0
    fi
    git switch -qdf "$sha1"
  ' >/dev/null 2>&1
  then
    _vidf_error "Failed to dirty-repair the submodules"
    return 2
  fi


  _vidf_info "Pruning git repository..."

  _vidf_git_base "$install_dir" -c gc.reflogExpire=now -c gc.reflogExpireUnreachable=now \
    gc --aggressive --prune=now >/dev/null 2>&1

  return 0
}

# Ensures git repository exists, fetches version tag or branch, and switches the repository
# to use that version.
#
# Is a combination of `git init`, `git fetch` and `git switch` all-in-one.
_vidf_git_ensure_switch()
{
  local install_dir
  install_dir="$1"
  local repo_url
  repo_url="$2"
  local version_tag
  version_tag="$3"

  _vidf_git_init "$install_dir"
  _vidf_git_switch "$install_dir" "$repo_url" "$version_tag"
}

_vidf_git_remote_tag_exists()
{
  local repo_url
  repo_url="$1"
  local remote_target
  remote_target="$2"

  if git ls-remote --exit-code --refs "$repo_url" \
    "refs/tags/$remote_target" "refs/heads/$remote_target" >/dev/null 2>&1
  then
    return 0
  fi

  return 1
}

_vidf_git_describe_dirty()
{
  local install_dir
  install_dir="$1"

  _vidf_git_wt "$install_dir" describe --tags --exact-match --dirty 2>/dev/null ||
  _vidf_git_wt "$install_dir" describe --exact-match --dirty 2>/dev/null
}


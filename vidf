_VIDF_VERSION="0.1.0-devel"

_vidf_is_sourced ()
{
  if [ -n "$ZSH_VERSION" ]
  then
    case "$ZSH_EVAL_CONTEXT" in
      *:file:*|*:file|file:*|file)
        return 0
        ;;
    esac
  else  # Add additional POSIX-compatible shell names here, if needed.
    case "${0##*/}" in
      dash|-dash|bash|-bash|ksh|-ksh|sh|-sh)
        return 0
        ;;
    esac
  fi
  return 1
}

_vidf_echo()
{
  while [ "$#" -gt 1 ]
  do
    printf "%s " "$1"
    shift
  done
  printf "%s\n" "${1:-}"
}

_vidf_err()
{
  _vidf_echo "$@" >&2
}

_vidf_error()
{
  _vidf_err "$(_vidf_style_red)$*$(_vidf_style_reset)"
}

_vidf_warn()
{
  _vidf_err "$(_vidf_style_yellow)$*$(_vidf_style_reset)"
}

_vidf_info()
{
  _vidf_err "$(_vidf_style_cyan)$*$(_vidf_style_reset)"
}

_vidf_success()
{
  _vidf_err "$(_vidf_style_green)$*$(_vidf_style_reset)"
}

_vidf_has()
{
  type "${1-}" >/dev/null 2>&1
  return "$?"
}

_vidf_read_hex_bytes()
{
  dd bs="$1" count=1 2>/dev/null | od -vAn -t x1 | xargs
}

# Reads at least 4 megabytes of data from stdin, and appends it to the file path
# specified by $1, then it prints to stdout the bytes copied.
#
# Returns 1 on EOF
_vidf_copy_chunk()
{
  local out_file
  out_file="$1"

  local bytes_copied

  bytes_copied="$(
    dd of="$out_file" bs=4M count=1 conv=notrunc oflag=append 2>&1 |
    awk '/^[0-9]+ bytes/ {print $1}'
  )"
  if [ "$bytes_copied" -eq 0 ]
  then
    return 1
  fi

  _vidf_echo "$bytes_copied"
  return 0
}

_VIDF_PROGRESS_SPIN_CHARS='/-\|'
_VIDF_PROGRESS_LAST_SECONDS=

_vidf_progress_render_spinner()
{
  local message
  message="$1"

  local cur_char
  local temp

  temp="${_VIDF_PROGRESS_SPIN_CHARS#?}"
  cur_char="${_VIDF_PROGRESS_SPIN_CHARS%"$temp"}"
  _VIDF_PROGRESS_SPIN_CHARS="${temp}${cur_char}"

  printf "\r\033[K\uff3b%s\uff3d %s" "$cur_char" "$message"
}

# Renders the spinner after 1 second.
#
# You should only be calling this function if you are not performing more work
# e.g. reached EOF on FIFO and you are just waiting for background process to die.
_vidf_progress_render_spinner_idle()
{
  local message
  message="$1"

  sleep 1
  _vidf_progress_render_spinner "$message"
}

# Returns 0 if at least 1 second has passed since the last call to this function
# or it's the first time it's called, 1 otherwise.
#
# You should only be calling this function if you want to render the spinner,
# but cannot call `_vidf_progress_render_spinner_idle` because you have to
# perform work.
_vidf_progress_can_render_spinner()
{
  if [ -z "$_VIDF_PROGRESS_LAST_SECONDS" ]
  then
    _VIDF_PROGRESS_LAST_SECONDS="$(date +%s)"
    return 0
  fi

  local cur_secs
  cur_secs="$(date +%s)"

  if [ "$_VIDF_PROGRESS_LAST_SECONDS" = "$cur_secs" ]
  then
    return 1
  fi

  _VIDF_PROGRESS_LAST_SECONDS="$cur_secs"

  return 0
}

# Executes a command in the background with an interactive progress spinner.
#
# $1: Custom message to show alongside spinner
# $@: Command to execute
#
# stdout and stderr are correctly handled, spinner render is directly sent to
# the current tty. If stderr or stdout are "tty"s, a FIFO is created in order to
# synchronize the 3 outputs.
#
# This function works specifically for commands that always output something to
# stderr/stdout, or stderr/stdout are closed by the command itself beforehand,
# otherwise the spinner won't appear due to dd being blocked waiting for data.
# In this specific app, it's used during file downloads. Always prefer to redirect
# the outputs if you are not sure if they output data regularly.
_vidf_progress_command()
(
  # Using subshell due to registering global traps

  local message
  message="$1"
  shift

  local tty
  if ! tty="$(tty 2>/dev/null)"
  then
    # Don't print any progress, directly execute the command on the foreground
    "$@"
    return
  fi

  # Prevents some race conditions from happening
  trap '' INT TERM HUP

  local temp_dir
  local bg_fifo
  local bg_buffer
  local temp_buffer
  if [ -t 1 ] || [ -t 2 ]
  then
    temp_dir="$(mktemp -d)"

    bg_fifo="$temp_dir/bg-fifo"
    mkfifo "$bg_fifo" || return 2

    bg_buffer="$temp_dir/bg-buffer"
    : >"$bg_buffer"

    temp_buffer="$temp_dir/bg-temp-buffer"
    : >"$temp_buffer"
  fi

  local bg_pid

  # Allows for caller redirections, as well as preventing output corruption
  # on a terminal.
  if [ -t 1 ] && [ -t 2 ]
  then
    "$@" >"$bg_fifo" 2>&1 &
  elif [ -t 1 ]
  then
    "$@" >"$bg_fifo" &
  elif [ -t 2 ]
  then
    "$@" 2>"$bg_fifo" &
  else
    "$@" &
  fi
  bg_pid="$!"

  if [ -n "$bg_fifo" ]
  then
    exec 3<"$bg_fifo"
  fi

  trap '
    kill -TERM "$bg_pid" >/dev/null 2>&1
    rm -rf "$temp_dir"
    printf "\r\033[K\033[?25h" >"$tty"
    _vidf_error "Operation aborted."
    exit 1
  ' INT TERM HUP

  printf "\033[?25l" >"$tty"

  local buffer_lines
  local eof
  eof=0

  while kill -0 "$bg_pid" >/dev/null 2>&1
  do
    if [ -z "$bg_fifo" ] || [ "$eof" = 1 ]
    then
      _vidf_progress_render_spinner_idle "$message" >"$tty"
      continue
    fi

    if ! _vidf_copy_chunk "$bg_buffer" <&3 >/dev/null
    then
      eof=1
      continue
    fi

    buffer_lines="$(wc -l < "$bg_buffer")"
    if [ "$buffer_lines" -gt 0 ]
    then
      printf "\r\033[K" >"$tty"
      head -n "$buffer_lines" "$bg_buffer" >"$tty"

      tail -n +"$((buffer_lines + 1))" "$bg_buffer" >"$temp_buffer"
      mv "$temp_buffer" "$bg_buffer"
    fi

    if _vidf_progress_can_render_spinner
    then
      _vidf_progress_render_spinner "$message" >"$tty"
    fi
  done

  printf "\r\033[K\033[?25h" >"$tty"

  if [ -n "$bg_fifo" ]
  then
    # One last flush to the fifo
    dd of="$bg_buffer" bs=4M conv=notrunc oflag=append <&3 2>/dev/null

    cat "$bg_buffer" >"$tty"

    # Doesn't end in newline, add one
    if [ -s "$bg_buffer" ] && [ "$(tail -c1 "$bg_buffer" | wc -l)" -eq 0 ]
    then
      _vidf_echo "" >"$tty"
    fi
  fi

  # Prevents some race conditions from happening.
  # Mainly the "kill" line, where if the process has already be waited on,
  # that line may kill another process completely different with the same pid.
  trap '' INT TERM HUP

  rm -rf "$temp_dir"

  wait "$bg_pid" >/dev/null 2>&1
)

# {{{ Interactive function helpers
# These functions require user interaction

# You must pass to it at least 2 arguments, the predicate and the cancelled message.
# A default value is provided for this two, so you can pass empty strings.
_vidf_user_confirms()
{
  local predicate
  predicate="${1:-"Is this ok?"} [y/N]: "

  local cancelled
  cancelled="${2:-"Operation cancelled."}"

  printf "%s" "$predicate" >&2

  local opt
  local read_exit_code
  while true
  do
    IFS="" read -r opt
    read_exit_code="$?"
    # Fixes visual bug where if you pipe `yes | vidf ...` you are going to
    # have the lines squished up on the same line.
    if ! [ -t 0 ] || [ "$read_exit_code" -ne 0 ]
    then
      _vidf_err ""
      [ "$read_exit_code" -ne 0 ] && break
    fi
    case "$opt" in
      [yY][eE][sS]|[yY])
        return 0
        ;;
      [nN][oO]|[nN]|"")
        break
        ;;
      *)
        printf "Please enter (y)es or (n)o: " >&2
        ;;
    esac
  done

  _vidf_error "$cancelled"
  return 1
}

_VIDF_MENU_CUR_ROW=
_VIDF_MENU_N_ROWS=
_VIDF_MENU_SAVED_STTY=
_VIDF_MENU_CUR_BYTE_SEQ=

# Must be run from subshell due to registering global traps
_vidf_menu_setup()
{
  if ! [ -t 2 ]
  then
    return 2
  fi

  _VIDF_MENU_SAVED_STTY="$(stty -g)"

  # Recovery traps
  # shellcheck disable=2064 disable=2154
  trap "
    if [ -n \"\$_VIDF_MENU_CUR_ROW\" ] && [ -n \"\$_VIDF_MENU_N_ROWS\" ]
    then
      remaining=\"\$((_VIDF_MENU_N_ROWS - _VIDF_MENU_CUR_ROW))\"
      if [ \"\$remaining\" -gt 0 ]
      then
        _vidf_menu_down \"\$remaining\"
      fi
    fi
    _vidf_menu_unsetup \"\$_VIDF_MENU_SAVED_STTY\"
    _vidf_error 'Operation aborted.'
    exit 1
  " INT TERM

  # These are permanent settings, must go after adding the recovery traps
  stty -icanon -echo min 1 time 0
  printf "\033[?25l" >&2
}

_vidf_menu_unsetup()
{
  stty "$_VIDF_MENU_SAVED_STTY"
  printf '\033[?25h' >&2
}

_vidf_menu_down()
{
  printf "\033[%dE" "$1" >&2
}

_vidf_menu_up()
{
  printf "\033[%dF" "$1" >&2
}

_vidf_menu_right()
{
  printf "\033[%dC" "$1" >&2
}

_vidf_menu_left()
{
  printf "\033[%dD" "$1" >&2
}

_vidf_menu_first_render()
{
  # If you wish to render single selection menus, then pass empty prefix
  local prefix_unselected
  prefix_unselected="$1"
  shift

  local n_rows
  n_rows="$#"

  # Render first row as pointed
  _vidf_err " $(_vidf_style_green; _vidf_style_bold)>$(_vidf_style_reset)" \
    "${prefix_unselected:+"$prefix_unselected "}$1"
  shift

  local i
  for i in "$@"
  do
    _vidf_err "   ${prefix_unselected:+"$prefix_unselected "}$i"
  done

  # Leave cursor on row 0, which is the current row
  _vidf_menu_up "$n_rows"
}

_vidf_menu_render_single_selected()
{
  # Assume cursor is in column 1 of currently pointed row

  # shellcheck disable=2059
  printf " $(_vidf_style_bold; _vidf_style_green)\u2714$(_vidf_style_reset)\r" >&2
}

_vidf_menu_render_selected()
{
  # Assume cursor is in column 1 of currently pointed row

  # Move to the right 3 positions (possible " > " padding)
  _vidf_menu_right 3

  # shellcheck disable=2059
  printf "$(_vidf_style_bold)\uff3b$(_vidf_style_green)\u2714$(_vidf_style_uncolor)\uff3d$(_vidf_style_unbold)\r" >&2
}

_vidf_menu_render_unselected()
{
  # Assume cursor is in column 1 of currently pointed row

  # Move cursor to the right 3 positions (possible " > " padding)
  _vidf_menu_right 3

  # shellcheck disable=2059
  printf "$(_vidf_style_bold)\uff3b \uff3d$(_vidf_style_unbold)\r" >&2
}

_vidf_menu_unrender_pointer()
{
  # Assume cursor is in column 1 of currently pointed row

  printf "  \r" >&2
}

# Consumes bytes from stdin, and handles up/down arrow keystrokes, anything else is
# output to stdout.
#
# When it reaches EOF, it returns code 1
_vidf_menu_navigate()
{
  _VIDF_MENU_CUR_BYTE_SEQ="$(_vidf_read_hex_bytes 1)"
  case "$_VIDF_MENU_CUR_BYTE_SEQ" in
    "1b")
      ;;
    "")
      return 1
      ;;
    *)
      return 0
      ;;
  esac

  _VIDF_MENU_CUR_BYTE_SEQ="$(_vidf_read_hex_bytes 1)"
  case "$_VIDF_MENU_CUR_BYTE_SEQ" in
    "5b")
      ;;
    "")
      return 1
      ;;
    *)
      _VIDF_MENU_CUR_BYTE_SEQ="1b $_VIDF_MENU_CUR_BYTE_SEQ"
      return 0
      ;;
  esac

  _VIDF_MENU_CUR_BYTE_SEQ="$(_vidf_read_hex_bytes 1)"
  case "$_VIDF_MENU_CUR_BYTE_SEQ" in
    "41" | "42")
      ;;
    "")
      return 1
      ;;
    *)
      _VIDF_MENU_CUR_BYTE_SEQ="1b 5b $_VIDF_MENU_CUR_BYTE_SEQ"
      return 0
      ;;
  esac

  if [ "$_VIDF_MENU_N_ROWS" -le 1 ]
  then
    _VIDF_MENU_CUR_BYTE_SEQ=
    # No-op, there is no rows to move to, so there is no need to unrender/render
    # the pointer in the same place. This stops flickering effect from happening as well.
    return 0
  fi

  _vidf_menu_unrender_pointer

  case "$_VIDF_MENU_CUR_BYTE_SEQ" in
    "41")
      if [ "$_VIDF_MENU_CUR_ROW" -gt 0 ]
      then
        _VIDF_MENU_CUR_ROW="$((_VIDF_MENU_CUR_ROW - 1))"
        _vidf_menu_up 1
      else
        # Wrap-around
        _VIDF_MENU_CUR_ROW="$((_VIDF_MENU_N_ROWS - 1))"
        _vidf_menu_down "$((_VIDF_MENU_N_ROWS - 1))"
      fi
      ;;
    "42")
      if [ "$_VIDF_MENU_CUR_ROW" -lt "$((_VIDF_MENU_N_ROWS - 1))" ]
      then
        _VIDF_MENU_CUR_ROW="$((_VIDF_MENU_CUR_ROW + 1))"
        _vidf_menu_down 1
      else
        # Wrap-around
        _VIDF_MENU_CUR_ROW=0
        _vidf_menu_up "$((_VIDF_MENU_N_ROWS - 1))"
      fi
      ;;
  esac

  _VIDF_MENU_CUR_BYTE_SEQ=

  # Write " > " indicator onto new position
  # shellcheck disable=2059
  printf " $(_vidf_style_bold; _vidf_style_green)>$(_vidf_style_reset)\r" >&2
  return 0
}

# Outputs to stdout the index of the argument that the user selected
_vidf_user_single_select()
(
  # Using a subshell so `exit` inside traps safely returns from the function without killing the parent shell.

  _vidf_menu_setup || return

  local title
  title="$1"
  shift

  _vidf_err "$(_vidf_style_bold)--- $title ---$(_vidf_style_unbold)"
  _vidf_err "Use $(_vidf_style_bold)[Up/Down Arrows]$(_vidf_style_unbold) to navigate, and" \
    "$(_vidf_style_bold)[Enter]$(_vidf_style_unbold) to confirm."

  _VIDF_MENU_N_ROWS="$#"
  _VIDF_MENU_CUR_ROW=0

  _vidf_menu_first_render "" "$@"

  while true
  do
    if ! _vidf_menu_navigate
    then
      _vidf_error "Unexpected EOF, Ctrl+D was pressed"
      return 1
    fi
    case "$_VIDF_MENU_CUR_BYTE_SEQ" in
      "0a")
        # Enter key pressed

        _vidf_menu_render_single_selected
        _vidf_menu_down "$((_VIDF_MENU_N_ROWS - _VIDF_MENU_CUR_ROW))"
        break
        ;;
    esac
  done

  _vidf_menu_unsetup

  _vidf_echo "$_VIDF_MENU_CUR_ROW"

  return 0
)

# Outputs to stdout the selected options as an space-separated quoted list
_vidf_user_multi_select()
(
  # Using a subshell so `exit` inside traps safely returns from the function without killing the parent shell.

  _vidf_menu_setup || return

  local title
  title="$1"
  shift

  _VIDF_MENU_N_ROWS="$#"
  _VIDF_MENU_CUR_ROW=0

  local menu_state
  # Array of objects, with keys "name" and "selected"
  menu_state="$(jq -nc '$ARGS.positional | map({"name": ., "selected": false})' --args -- "$@")"

  _vidf_err "$(_vidf_style_bold)--- $title ---$(_vidf_style_unbold)"
  _vidf_err "Use $(_vidf_style_bold)[Up/Down Arrows]$(_vidf_style_unbold) to navigate," \
    "$(_vidf_style_bold)[A]$(_vidf_style_unbold) to toggle all," \
    "$(_vidf_style_bold)[Space]$(_vidf_style_unbold) to toggle currently selected row, and" \
    "$(_vidf_style_bold)[Enter]$(_vidf_style_unbold) to confirm."

  _vidf_menu_first_render "$(_vidf_style_bold)$(printf "\uff3b \uff3d")$(_vidf_style_unbold)" "$@"

  local original_row
  local new_selected
  local i

  while true
  do
    if ! _vidf_menu_navigate
    then
      _vidf_error "Unexpected EOF, Ctrl+D was pressed"
      return 1
    fi
    case "$_VIDF_MENU_CUR_BYTE_SEQ" in
      "20")
        # Space key pressed

        menu_state="$(_vidf_echo "$menu_state" | jq -c ".[$_VIDF_MENU_CUR_ROW].selected |= not")"
        if [ "$(_vidf_echo "$menu_state" | jq -r ".[$_VIDF_MENU_CUR_ROW].selected")" = true ]
        then
          _vidf_menu_render_selected
        else
          _vidf_menu_render_unselected
        fi
        ;;
      "0a")
        # Enter key pressed

        _vidf_menu_unrender_pointer
        _vidf_menu_down "$((_VIDF_MENU_N_ROWS - _VIDF_MENU_CUR_ROW))"
        break
        ;;
      "41"|"61")
        # A key pressed

        new_selected="$(_vidf_echo "$menu_state" | jq 'any(.selected == false)')"
        menu_state="$(_vidf_echo "$menu_state" | jq -c ".[].selected = $new_selected")"

        original_row="$_VIDF_MENU_CUR_ROW"

        if [ "$_VIDF_MENU_CUR_ROW" -gt 0 ]
        then
          _vidf_menu_up "$_VIDF_MENU_CUR_ROW"
          _VIDF_MENU_CUR_ROW=0
        fi

        i=0
        while [ "$i" -lt "$_VIDF_MENU_N_ROWS" ]
        do
          if [ "$new_selected" = true ]
          then
            _vidf_menu_render_selected
          else
            _vidf_menu_render_unselected
          fi

          if [ "$i" -lt "$((_VIDF_MENU_N_ROWS - 1))" ]
          then
            _vidf_menu_down 1
            _VIDF_MENU_CUR_ROW="$((_VIDF_MENU_CUR_ROW + 1))"
          fi
          i="$((i + 1))"
        done

        if [ "$_VIDF_MENU_CUR_ROW" -gt "$original_row" ]
        then
          _vidf_menu_up "$((_VIDF_MENU_CUR_ROW - original_row))"
          _VIDF_MENU_CUR_ROW="$original_row"
        fi
        ;;
    esac
  done

  _vidf_menu_unsetup

  _vidf_echo "$menu_state" | jq -r '.[] | select(.selected) | .name' |
  while IFS="" read -r line
  do
    printf " %s" "$(_vidf_sanitize_arg "$line")"
  done

  _vidf_echo ""

  return 0
)

# }}}

_vidf_app_dir()
{
  local app_dir
  app_dir="${VIDF_DIR:-"$HOME/.vidf"}"

  if [ "$app_dir" = "${app_dir#/}" ]
  then
    if [ -n "${VIDF_DIR:-}" ]
    then
      _vidf_error "$(_vidf_style_underline)VIDF_DIR$(_vidf_style_ununderline)" \
        "variable must be an absolute path."
    else
      _vidf_error "$(_vidf_style_underline)HOME$(_vidf_style_ununderline)" \
        "variable must be an absolute path."
    fi
    return 1
  fi

  _vidf_echo "$app_dir"
  return 0
}

_vidf_cache_dir()
{
  local cache_dir
  cache_dir="$XDG_CACHE_HOME"
  if [ "$cache_dir" = "${cache_dir#/}" ]
  then
    cache_dir="$HOME/.cache"
  fi
  cache_dir="$cache_dir/vidf"
  _vidf_echo "$cache_dir"
  return 0
}

# Downloads a file using curl, and saves it into the app cache directory,
# it also saves a .etag file that stores the resource's ETag the server returned,
# to be send in future requests to help with server-side caching.
#
# It outputs to stdout the downloaded file path
_vidf_download_file()
(
  # Using a subshell due to registering global traps

  local url
  url="$1"

  local filepath
  filepath="$(_vidf_cache_dir)"
  if ! mkdir -p "$filepath"
  then
    _vidf_error "Couldn't create cache directory: $(_vidf_style_bold)$filepath$(_vidf_style_unbold)"
    return 2
  fi

  local filename
  filename="${url%"?"*}"
  filename="$(basename "$filename")"

  filepath="$filepath/$filename"

  local etag_path
  etag_path="$filepath.etag"

  local tty
  if ! tty="$(tty 2>/dev/null)"
  then
    # Don't print any progress, directly execute the command on the foreground
    if ! curl -fSsLo "$filepath" -z "$filepath" --etag-save "$etag_path" --etag-compare "$etag_path" "$url"
    then
      _vidf_error "Failed to download $(_vidf_style_bold)$filename$(_vidf_style_unbold)." \
        "Try again later."
      return 2
    fi
    return 0
  fi

  # This sends a HEAD request and checks:
  #
  # 1. How many bytes there is before starting download
  # 2. Current cached ETag is valid or not
  # 3. Current filepath's modtime (If-Modified-Since) is valid or not
  # 4. And finally the response code for all of this parameters
  local header
  header="$(
    curl -sLIw "%{http_code},%header{Content-Length}" \
      -z "$filepath" --etag-compare "$etag_path" -o/dev/null "$url"
  )"
  local http_code
  http_code="${header%%,*}"
  if [ "$http_code" = 304 ]
  then
    _vidf_echo "$filepath"
    return 0
  fi
  rm -f "$filepath" "$filepath.etag"

  local content_length
  content_length="${header#*,}"
  case "$content_length" in
    *[!0-9]*)
      content_length=""
      ;;
  esac

  local message
  message="Downloading $filename..."

  # Prevents some race conditions from happening, as well as possibly passing
  # this signals down to _vidf_progress_command function
  trap '' INT TERM HUP

  local temp_dir
  temp_dir="$(mktemp -d)"

  local err_buffer

  if [ -t 2 ]
  then
    err_buffer="$temp_dir/err-buffer"
    : >"$err_buffer"
  fi

  if [ -z "$content_length" ] || [ "$content_length" -le 0 ]
  then
    # Couldn't determine content length, render simple spinner, no bar

    local curl_exit_code
    _vidf_progress_command "$message" \
      curl -fSsLo "$filepath" -z "$filepath" --etag-save "$etag_path" --etag-compare "$etag_path" "$url" \
      >/dev/null 2>"${err_buffer:-"/dev/null"}"
    curl_exit_code="$?"
    if [ "$curl_exit_code" != 0 ]
    then
      cat "${err_buffer:-"/dev/null"}" >&2
      _vidf_error "Failed to download $(_vidf_style_bold)$filename$(_vidf_style_unbold)." \
        "Try again later."
    else
      _vidf_echo "$filepath"
    fi

    rm -rf "$temp_dir"

    return "$curl_exit_code"
  fi

  local out_fifo
  out_fifo="$temp_dir/out-fifo"
  mkfifo "$out_fifo" || return

  # Race condition where `_vidf_copy_chunk` wins a race by creating $filepath
  # before curl can extract the modtime of the file, so it will always treat it
  # as recent cache.
  #
  # Extract the modtime before launching curl
  local modtime
  modtime="$(date -ur "$filepath" +"%d %b %Y %T GMT" 2>/dev/null)"

  if [ -n "$err_buffer" ]
  then
    curl -fSsLz "$modtime" --etag-save "$etag_path" --etag-compare "$etag_path" "$url" \
      >"$out_fifo" 2>"$err_buffer" &
  else
    curl -fSsLz "$modtime" --etag-save "$etag_path" --etag-compare "$etag_path" "$url" \
      >"$out_fifo" -v &
  fi
  local bg_pid
  bg_pid="$!"

  exec 3<"$out_fifo"

  trap '
    kill -TERM "$bg_pid" >/dev/null 2>&1
    rm -rf "$temp_dir"
    printf "\r\033[K\033[?25h" >"$tty"
    _vidf_error "Operation aborted."
    exit 1
  ' INT TERM HUP

  printf "\033[?25l" >"$tty"

  local bytes_read
  local bytes_copied
  bytes_copied=0

  # Progress bar
  local percentage
  local filled
  local empty
  local bar

  local i

  while kill -0 "$bg_pid" >/dev/null 2>&1
  do
    bytes_read="$(_vidf_copy_chunk "$filepath" <&3)"

    bytes_copied="$((bytes_copied + bytes_read))"

    if ! _vidf_progress_can_render_spinner
    then
      continue
    fi

    percentage="$(( (bytes_copied * 100) / content_length ))"
    [ "$percentage" -gt 100 ] && percentage=100

    # 20 fixed width progress bar
    filled="$(( (percentage * 20) / 100 ))"
    empty="$(( 20 - filled ))"

    bar=""
    i=0
    while [ "$i" -lt "$filled" ]
    do
      bar="$bar="
      i="$((i + 1))"
    done
    i=0
    while [ "$i" -lt "$empty" ]
    do
      bar="$bar-"
      i="$((i + 1))"
    done

    _vidf_progress_render_spinner "$message $(printf "\uff3b%s\uff3d" "$bar") $percentage%" >"$tty"
  done

  # One last flush to the fifo
  dd of="$filepath" bs=4M conv=notrunc oflag=append <&3 2>/dev/null

  # Prevents some race conditions
  trap '' INT TERM HUP

  local bg_exit_code
  wait "$bg_pid" >/dev/null 2>&1;
  bg_exit_code="$?"
  if [ "$bg_exit_code" = 0 ]
  then
    # Last succesful progress bar render
    bar="===================="
    printf "\r\033[K\uff3b\u2714\uff3d %s [%s] 100%%\n" "$message" "$bar" >"$tty"
    _vidf_echo "$filepath"
  elif [ -n "$err_buffer" ]
  then
    _vidf_err ""
    cat "$err_buffer" >&2
    _vidf_error "Failed to download $(_vidf_style_bold)$filename$(_vidf_style_unbold)." \
      "Try again later"
  fi
  printf "\033[?25h" >"$tty"
  rm -rf "$temp_dir"
  return "$bg_exit_code"
)

# Argument-handling functions {{{

# Output is already quoted.
_vidf_sanitize_arg()
{
  local sanitized

  sanitized="$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"

  printf "'%s'" "$sanitized"
}

# Canonizes flags, converts them from the form:
#
#   --foo=bar -abc
#
# To:
#
#   --foo 'bar' -a -b -c
#
# The $1 format is similar to the one on _vidf_check_args, except that you must
# trim the arguments range from the beginning, e.g:
#
# "-y,--prefix:,-h,--help"
_vidf_canonize_args()
{
  local flags
  # Normalize flags, separate in newlines, apply colons to all aliases that
  # end on colon (:), and finally one last separation with newlines of aliases.
  # We don't use the slashes because this command is indifferent regarding aliases,
  # aliases overwrite other aliases.
  flags="$(_vidf_echo "$1" | awk '
    BEGIN {
      FS = ","

      short_opts = ""
      long_opts = ""
    }
    {
      for (i = 1; i <= NF; i++)
        {
          alias_group = $i
          has_colon = sub(/:$/, "", alias_group) > 0
          n_aliases = split(alias_group, aliases, "/")
          for (j = 1; j <= n_aliases; j++)
            {
              alias = aliases[j] (has_colon ? ":" : "")

              if (sub(/^--/, "", alias))
                {
                  long_opts = (long_opts == "") ? alias : long_opts "," alias
                }
              else
                {
                  sub(/^-/, "", alias)
                  short_opts = short_opts alias
                }
            }
        }
    }
    END {
      print short_opts, long_opts
    }
  ')"
  shift

  local short_opts
  short_opts="${flags%" "*}"
  local long_opts
  long_opts="${flags#*" "}"

  local temp_err
  temp_err="$(mktemp)"

  local getopt_exit_code
  getopt_exit_code=0
  if ! LANGUAGE=C getopt -o "$short_opts" -l "$long_opts" -- "$@" 2>"$temp_err"
  then
    getopt_exit_code=1
    _vidf_error "$(sed -E 's/^getopt:\s*(.)/\u\1/' "$temp_err")"
  fi

  rm -rf "$temp_err"
  return "$getopt_exit_code"
}

# Same as _vidf_canonize_args, but the output of this function is safe to be
# passed to `eval` command in order to set the canonized arguments.
_vidf_canonize_args_eval()
{
  local flags
  flags="$1"
  shift

  local parsed_args

  if ! parsed_args="$(_vidf_canonize_args "$flags" "$@")"
  then
    _vidf_echo "false"
    return 0
  fi

  printf "set -- %s\n" "$parsed_args"

  return 0
}

# NOTE: We don't use getopts because it doesn't accept long options
#
# The $1 format parameter is similar to getopts format, except that
# it starts with the minimum and maximum number of required positional
# arguments, followed by a comma-separated list of valid short and long
# options. You can also pass a plus sign (+) after the minimum required
# positional arguments to indicate the user can pass infinite arguments.
# You can also pass aliased flags, you can have multiple aliased flags.
#
# User arguments must be canonized with _vidf_canonize_args_eval function.
#
# Basic format:
# "2,-y,--prefix:,--version"
#
# Format for variadic arguments, minimum 0 args and maximum 2 args:
# "0-2,-y,--prefix:,--version"
#
# Infinite arguments, minimum 1:
# "1+,-y,--prefix:,--version"
#
# Aliased flags:
# "2,-y/--yes,-p/--prefix:"
_vidf_check_args()
{
  local format
  format="$1"
  shift

  local expected_arg_range
  expected_arg_range="${format%%,*}"

  local flags
  flags="${format#*,}"

  # Separate in newlines for better handling.
  flags="$(_vidf_echo "$flags" | sed 's/,/\n/g')"

  local expected_min_args
  local expected_max_args
  case "$expected_arg_range" in
    *+)
      expected_min_args="${expected_arg_range%+}"
      expected_max_args=-1
      ;;
    *-*)
      expected_min_args="${expected_arg_range%%-*}"
      expected_max_args="${expected_arg_range#*-}"
      ;;
    *)
      expected_min_args="$expected_arg_range"
      expected_max_args="$expected_arg_range"
      ;;
  esac

  local arg_count
  arg_count=0

  local matched_flag

  while [ "$#" -gt 0 ]
  do
    case "$1" in
      --)
        shift
        arg_count="$((arg_count + $#))"
        break
        ;;
      -*[!-a-zA-Z0-9]*)
        # Contains invalid characters.
        _vidf_error "Unrecognized option '$1'"
        return 1
        ;;
      -*)
        if ! matched_flag="$(_vidf_echo "$flags" | grep -E "(^|/)$1(:|\$|/)")"
        then
          _vidf_error "Unrecognized option '$1'"
          return 1
        fi

        if [ "$matched_flag" != "${matched_flag%:}" ]
        then
          if [ "$#" -lt 2 ]
          then
            _vidf_error "Option '$1' requires an argument"
            return 1
          fi

          shift 2
          continue
        fi

        shift
        continue
        ;;
      *)
        arg_count=$((arg_count + 1))
        shift
        ;;
    esac
  done

  if [ "$arg_count" -lt "$expected_min_args" ]
  then
    _vidf_error "Too few arguments. Expected at least $expected_min_args, got $arg_count."
    return 1
  fi

  if [ "$expected_max_args" -ne -1 ] && [ "$arg_count" -gt "$expected_max_args" ]
  then
    _vidf_error "Too many arguments. Expected at most $expected_max_args, got $arg_count."
    return 1
  fi
}

# This function outputs to stdout a shell program to be eval'd by the caller,
# which is going to parse the arguments/flags of the user, and save it to
# flag variables specified on $2, and the parsed positional arguments are going
# to be saved on the caller's argument list, e.g. $1, $2, $3, ..., $N, etc.
#
# Function's parameters:
#
# - $1: Format specifier, see _vidf_check_args.
#
# - $2: Comma-separated flag shell variables list, their positions must correspond to
# the positions on the format specifier, if the format specifier doesn't list
# any flags, then you MUST NOT pass this argument, not even an empty string,
# you must directly pass the user's $@ list after $1.
#
# - $@: User's arguments, must be canonized.
_vidf_parse_args_eval()
{
  local format
  format="$1"
  shift

  local flag_vars
  [ -n "${format#*,}" ] && flag_vars="$1" && shift

  if ! _vidf_check_args "$format" "$@"
  then
    _vidf_echo "false"
    return 0
  fi

  local expected_flags
  expected_flags="${format#*,}"

  # Separate in newlines for better handling
  expected_flags="$(printf "%s" "$expected_flags" | sed 's/,/\n/g')"
  flag_vars="$(printf "%s" "$flag_vars" | sed 's/,/\n/g')"

  local matched_flag
  local target_var
  local flag_line_num

  local set_args_eval
  while [ "$#" -gt 0 ]
  do
    case "$1" in
      --)
        shift
        while [ "$#" -gt 0 ]
        do
          set_args_eval="$set_args_eval $(_vidf_sanitize_arg "$1")"
          shift
        done
        break
        ;;
      -*)
        matched_flag="$(_vidf_echo "$expected_flags" | awk '
          /(^|\/)'"$1"'(:|$|\/)/ {
            print NR, $0
            exit
          }
        ')"

        flag_line_num="${matched_flag%%" "*}"
        matched_flag="${matched_flag#*" "}"

        target_var="$(_vidf_echo "$flag_vars" | sed -n "${flag_line_num}p")"

        if [ "$matched_flag" != "${matched_flag#*:}" ]
        then
          shift
          _vidf_echo "$target_var=$(_vidf_sanitize_arg "$1")"
        else
          _vidf_echo "$target_var=1"
        fi
        ;;
      *)
        set_args_eval="$set_args_eval $(_vidf_sanitize_arg "$1")"
        ;;
    esac
    shift
  done

  printf "set --%s\n" " $set_args_eval"
}

# Returns the first argument that is not an option nor its value.
#
# $@ - User's arguments, this are required to be non-canonized due to the fact
#      that the subcommand is treated as a regular positional argument.
_vidf_find_subcommand()
{
  local skip_arg
  skip_arg=0
  local i

  for i in "$@"
  do
    if [ "$skip_arg" = 1 ]
    then
      skip_arg=0
      continue
    fi

    case "$i" in
      --color)
        # Add to pattern above known global options on canonical form that
        # contains a value.
        skip_arg=1
        ;;
      -*)
        ;;
      *)
        local subcommand
        subcommand="$i"
        [ -z "$subcommand" ] && return 1
        _vidf_echo "$subcommand"
        return 0
        ;;
    esac
  done

  return 1
}

# Removes the subcommand and return everything else as an space separated list.
#
# $@ - User's arguments, this are required to be non-canonized due to the fact
#      that the subcommand is treated as a regular positional argument.
_vidf_filter_subcommand()
{
  if [ "$#" -lt 1 ]
  then
    return 0
  fi

  local subcommand_found
  subcommand_found=0
  local skip_arg
  skip_arg=0
  local i
  for i in "$@"
  do
    if [ "$skip_arg" = 1 ] || [ "$subcommand_found" = 1 ]
    then
      skip_arg=0
      printf " %s" "$(_vidf_sanitize_arg "$i")"
      continue
    fi

    case "$i" in
      --color)
        skip_arg=1
        printf " %s" "$(_vidf_sanitize_arg "$i")"
        ;;
      -*)
        printf " %s" "$(_vidf_sanitize_arg "$i")"
        ;;
      *)
        subcommand_found=1
        ;;
    esac
  done

  _vidf_echo ""
}

# See _vidf_filter_subcommand, outputs a program to be eval'd by the caller,
# which is going to filter out the subcommand from user's arguments.
# You must have already called _vidf_find_subcommand in order to get the subcommand
# before eval'ing this function's output, and pass that as the first argument.
_vidf_filter_subcommand_eval()
{
  printf "set -- %s" "$(_vidf_filter_subcommand "$@")"
}

